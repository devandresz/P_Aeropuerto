@{
    var role = Context.Session.GetString("UserRole");
    var username = Context.Session.GetString("UserName") ?? "Usuario";

    var isAdmin = string.Equals(role, "Administrador", StringComparison.OrdinalIgnoreCase) ||
                  string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);

    var isClient = string.Equals(role, "Cliente", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AeroPortal</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css?v=20260515" />
    <style>
        .airport-navbar { background-color: #122240 !important; }
        .nav-link { font-weight: 500; }
        .user-badge { background-color: #457b9d; color: white; padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; display: inline-block; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark airport-navbar shadow-sm">
        <div class="container">
            <a class="navbar-brand airport-brand" href="/">
                <span class="brand-mark">A</span> AeroPortal
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">

                    @if (string.IsNullOrWhiteSpace(role))
                    {
                        <li class="nav-item"><a class="nav-link" href="/">Acceso</a></li>
                    }

                    @if (isAdmin)
                    {
                        <li class="nav-item"><a class="nav-link fw-bold text-info" asp-controller="Modules" asp-action="Dashboard">📊 Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Tripulacion">🧑‍✈️ Tripulación</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="HistorialVuelo">📜 Historial Vuelos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Usuarios">👥 Usuarios</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Aerolineas">🏢 Aerolíneas</a></li>
                    }

                    @if (isClient)
                    {
                        <li class="nav-item"><a class="nav-link fw-bold text-warning" asp-controller="Vuelo" asp-action="Index">✈️ Buscar Vuelos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Equipaje">🧳 Mi Equipaje</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Factura">📄 Mis Facturas</a></li>
                    }

                    <li class="nav-item"><a class="nav-link" asp-controller="Info" asp-action="About">Servicios</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Info" asp-action="Contact">Soporte</a></li>
                </ul>

                @if (!string.IsNullOrWhiteSpace(role))
                {
                    <div class="d-flex align-items-center gap-3">
                        <span class="user-badge">👤 @username (@role)</span>
                        <a class="btn btn-outline-danger btn-sm" href="/">Salir</a>
                    </div>
                }
            </div>
        </div>
    </nav>

    <div class="body-content">
        @RenderBody()
        <footer class="airport-footer mt-5 text-center text-muted py-3">
            <p>&copy; @DateTime.Now.Year AeroPortal. Plataforma de acceso aeroportuario.</p>
        </footer>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js?v=20260515"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>