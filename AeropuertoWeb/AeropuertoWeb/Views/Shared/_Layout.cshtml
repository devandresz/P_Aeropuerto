@{
    var role = Context.Session.GetString("UserRole");
    var isAdmin = string.Equals(role, "Administrador", StringComparison.OrdinalIgnoreCase) || string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);
    var isClient = string.Equals(role, "Cliente", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AeroPortal</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css?v=20260515" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark airport-navbar">
        <div class="container">
            <a class="navbar-brand airport-brand" asp-controller="Auth" asp-action="Login">
                <span class="brand-mark">A</span>
                AeroPortal
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegacion" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">Acceso</a></li>
                    @if (!string.IsNullOrWhiteSpace(role))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Dashboard">Modulos</a></li>
                    }
                    @if (isAdmin)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Usuarios">Usuarios</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Aerolineas">Aerolineas</a></li>
                    }
                    @if (isClient)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Equipaje">Mi equipaje</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Modules" asp-action="Factura">Mis facturas</a></li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-controller="Info" asp-action="About">Servicios</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Info" asp-action="Contact">Soporte</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="body-content">
        @RenderBody()
        <footer class="airport-footer">
            <p>&copy; @DateTime.Now.Year AeroPortal. Plataforma de acceso aeroportuario.</p>
        </footer>
    </div>
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js?v=20260515"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
