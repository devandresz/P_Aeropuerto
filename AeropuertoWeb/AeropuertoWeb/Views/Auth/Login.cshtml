@model LoginViewModel
@{
    ViewData["Title"] = "Acceso";
}

<main class="login-page">
    <section class="login-hero" aria-labelledby="loginTitle">
        <div class="login-copy">
            <span class="eyebrow">Sistema aeroportuario</span>
            <h1 id="loginTitle">Bienvenido a AeroPortal</h1>
            <p>Accede como cliente para consultar tus vuelos y servicios, o como administrador para gestionar operaciones internas.</p>
            <div class="trust-strip" aria-label="Beneficios de acceso">
                <div><strong>24/7</strong><span>Disponibilidad</span></div>
                <div><strong>2 perfiles</strong><span>Cliente y admin</span></div>
                <div><strong>Seguro</strong><span>Validación inicial</span></div>
            </div>
        </div>

        <section class="login-card" aria-labelledby="accessTitle">
            <div class="login-card-header">
                <span class="login-icon" aria-hidden="true">+</span>
                <div>
                    <h2 id="accessTitle">Iniciar sesión</h2>
                    <p>Elige el tipo de usuario para continuar.</p>
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="login-alert" role="alert" style="color: #721c24; background-color: #f8d7da; border-color: #f5c6cb; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
                    @ViewBag.Error
                </div>
            }

            <div class="role-switch" role="tablist" aria-label="Tipo de acceso">
                <input type="radio" id="roleClient" name="role" value="Cliente" checked="checked" />
                <label for="roleClient">Cliente</label>
                <input type="radio" id="roleAdmin" name="role" value="Administrador" />
                <label for="roleAdmin">Administrador</label>

                <form class="role-panel client-panel" asp-controller="Usuario" asp-action="LoginCliente" method="post">
                    <div class="field-group">
                        <label>Correo electrónico</label>
                        <input name="correo" class="form-control login-input" type="email" placeholder="cliente@aeroport.com" required />
                    </div>
                    <div class="field-group">
                        <label>Contraseña</label>
                        <input name="password" class="form-control login-input" type="password" placeholder="Tu contraseña" required />
                    </div>
                    <div class="form-row-options">
                        <label class="check-option"><input type="checkbox" /> Recordarme</label>
                        <a href="#">Recuperar acceso</a>
                    </div>
                    <button type="submit" class="btn btn-primary login-button">Entrar como cliente</button>
                </form>

                <form class="role-panel admin-panel" asp-controller="Usuario" asp-action="LoginCliente" method="post">
                    <div class="field-group">
                        <label>Usuario o Correo Administrativo</label>
                        <input name="correo" class="form-control login-input" type="text" placeholder="admin@aeroport.com" required />
                    </div>
                    <div class="field-group">
                        <label>Contraseña</label>
                        <input name="password" class="form-control login-input" type="password" placeholder="Contraseña administrativa" required />
                    </div>
                    <div class="field-group">
                        <label>Código de seguridad (Opcional)</label>
                        <input name="AdminCode" class="form-control login-input" placeholder="Código interno" />
                    </div>
                    <button type="submit" class="btn btn-primary login-button admin-button">Entrar como administrador</button>
                </form>
            </div>
        </section>
    </section>
</main>