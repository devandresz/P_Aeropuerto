@{
    ViewData["Title"] = "Confirmacion";
}

<main class="ops-page">
    <section class="ops-shell">
        <div class="ops-hero">
            <div>
                <span class="eyebrow">Compra</span>
                <h1>Reserva confirmada</h1>
                <p>@ViewBag.Mensaje</p>
            </div>
            <div class="ops-actions">
                <a class="ops-button secondary" asp-controller="Modules" asp-action="Vuelos">Volver a vuelos</a>
                <a class="ops-button" asp-controller="Cliente" asp-action="Dashboard">Mi panel</a>
            </div>
        </div>
        <div class="ops-metrics">
            <div class="ops-metric"><span>Ticket</span><strong>@ViewBag.NumeroTicket</strong></div>
            <div class="ops-metric"><span>Estado</span><strong>Confirmado</strong></div>
            <div class="ops-metric"><span>API</span><strong>Temporal</strong></div>
            <div class="ops-metric"><span>Ruta</span><strong>Vuelo</strong></div>
        </div>
    </section>
</main>
